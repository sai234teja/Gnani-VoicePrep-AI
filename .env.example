# ==============================================================================
# Gnani VoicePrep AI - Unified Environment Configuration Template
# Copy this file to .env (or backend/.env) and populate with your secure secrets.
# DO NOT COMMIT REAL CREDENTIALS OR KEYS TO SOURCE CONTROL.
# ==============================================================================

# Application Environment: 'development', 'staging', or 'production'
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8010

# Security & CORS Allowlists
# In production, provide comma-separated origins, e.g.: https://voiceprep.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8010,http://127.0.0.1:8010

# Cryptographic Keys (Required in production)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=change_me_to_a_secure_32_byte_hex_string_for_production
# Symmetrical encryption key for stored recordings (Fernet base64 url-safe key)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RECORDING_ENCRYPTION_KEY=change_me_to_a_fernet_compatible_key_for_production

# Gnani.ai API Configuration
# Get your API key from the Gnani.ai Developer Console (https://vachana.ai)
GNANI_API_KEY=your_gnani_api_key_here

# Speech-to-Text (STT) - Gnani Prisma v3
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0

# Text-to-Speech (TTS) - Gnani Timbre v2.5
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Nalini

# Database Configuration (Defaults to SQLite in backend/storage/secure_assess.db)
DATABASE_URL=sqlite:///./storage/secure_assess.db
# Retention Period (Days) for Candidate Logs & Recordings
DATA_RETENTION_DAYS=30

